{
  "enabled": true,
  "scan_interval": 3.0,
  "lock_port": 49222,
  "customization": {
    "language": "zh-CN",
    "show_quota_badge": true,
    "quota_refresh_interval": 60,
    "enable_gpu_acceleration": true,
    "disable_background_throttling": true,
    "expand_v8_memory": true,
    "disable_telemetry": true,
    "hide_ide_buttons": true,
    "proxy_enabled": false,
    "proxy_url": "http://127.0.0.1:10808",
    "disable_auto_update": true,
    "enable_smooth_scrolling": true,
    "compact_ui_mode": false,
    "prune_guide_skills": false,
    "auto_retry_on_error": true,
    "max_retry_count": 3,
    "notify_on_quota_exhausted": true,
    "notify_on_max_retry_failed": true
  },
  "channels": {
    "telegram": {
      "enabled": true,
      "bot_token": "YOUR_TELEGRAM_BOT_TOKEN",
      "chat_id": "YOUR_CHAT_ID",
      "proxy": "http://127.0.0.1:7890"
    },
    "feishu": {
      "enabled": false,
      "webhook_url": "https://open.feishu.cn/open-apis/bot/v2/hook/xxxxxxxx"
    },
    "wecom": {
      "enabled": false,
      "webhook_url": "https://qyapi.weixin.qq.com/cgi-bin/webhook/send?key=xxxxxxxx"
    }
  }
}
